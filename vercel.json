{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/product/geometric-gold-tone-statement-earrings-for-women-modern-square-earrings",
      "destination": "/product/avirena-square-studs-gold-tone-brass-earrings",
      "permanent": true
    },
    {
      "source": "/product/gold-tone-drop-earrings-for-women-minimalist-long-dangle-earrings",
      "destination": "/product/avirena-drop-earrings-gold-tone-brass",
      "permanent": true
    },
    {
      "source": "/product/gold-tone-statement-drop-earrings-for-women-geometric-dangle-earrings",
      "destination": "/product/avirena-statement-drops-geometric-brass-earrings",
      "permanent": true
    },
    {
      "source": "/product/nadir-square-studs-gold-tone-brass-earrings",
      "destination": "/product/avirena-square-studs-gold-tone-brass-earrings",
      "permanent": true
    },
    {
      "source": "/product/lume-drop-earrings-gold-tone-brass",
      "destination": "/product/avirena-drop-earrings-gold-tone-brass",
      "permanent": true
    },
    {
      "source": "/product/forma-statement-drops-geometric-brass-earrings",
      "destination": "/product/avirena-statement-drops-geometric-brass-earrings",
      "permanent": true
    },
    {
      "source": "/product/amara-heart-drops-silver-tone-earrings",
      "destination": "/product/avirena-heart-drops-silver-tone-earrings",
      "permanent": true
    },
    {
      "source": "/product/volute-spiral-earrings-silver-tone",
      "destination": "/product/avirena-spiral-earrings-silver-tone",
      "permanent": true
    },
    {
      "source": "/product/solene-crystal-hoops-gold-tone-earrings",
      "destination": "/product/avirena-crystal-hoops-gold-tone-earrings",
      "permanent": true
    },
    {
      "source": "/product/solene-crystal-hoops-silver-tone-earrings",
      "destination": "/product/avirena-crystal-hoops-silver-tone-earrings",
      "permanent": true
    },
    {
      "source": "/product/petra-pebble-studs-gold-tone-earrings",
      "destination": "/product/avirena-pebble-studs-gold-tone-earrings",
      "permanent": true
    },
    {
      "source": "/product/foglia-leaf-studs-gold-tone-earrings",
      "destination": "/product/avirena-leaf-studs-gold-tone-earrings",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-HSiUM2ls02MhpzK2IZOw8m07yCGxDS9Bo2DpVBEQK7I='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://cdn.shopify.com https://images.unsplash.com https://imagedelivery.net https://www.google-analytics.com https://www.googletagmanager.com https://www.google.com; connect-src 'self' https://*.myshopify.com https://checkout.avirenajewels.com https://cdn.shopify.com https://api.postalpincode.in https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://www.google.com; media-src 'self' https://*.myshopify.com https://checkout.avirenajewels.com https://cdn.shopify.com; form-action 'self' https://*.myshopify.com https://shop.app https://checkout.shopify.com; frame-src 'self' https://*.myshopify.com https://checkout.shopify.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), usb=(), interest-cohort=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
