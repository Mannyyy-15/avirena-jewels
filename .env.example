# Avirena Jewels - Shopify Headless Storefront Environment Variables

# Shopify Storefront API Configuration
# Replace with your actual Shopify store domain (e.g. avirenajewels.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN="your-shop-name.myshopify.com"

# Shopify Storefront Access Token (Generated under Apps -> Storefront API in Shopify Admin)
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Shopify API Version (Default: 2025-01)
VITE_SHOPIFY_API_VERSION="2025-01"

# App URL
APP_URL="http://localhost:3000"
